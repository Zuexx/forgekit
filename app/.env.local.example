# Database
DATABASE_URL=postgresql://localhost:5432/forgekit

# Database user, read by the pg client. Kept out of DATABASE_URL, where a user:host
# string reads as a credential to secret scanners.
PGUSER=postgres

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Comma-separated user ids granted the admin role. Empty means no admins, which is the
# starter-kit default — a shipped id would make its holder an administrator of every fork.
BETTER_AUTH_ADMIN_USER_IDS=

# Comma-separated extra origins allowed to receive auth callbacks and redirects.
# BETTER_AUTH_URL's origin is always trusted; add others only when a separate frontend,
# preview deployment, or mobile scheme needs to complete sign-in.
BETTER_AUTH_TRUSTED_ORIGINS=

# Azure AD / Microsoft OAuth (optional)
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=

# Other configurations
# Add other environment variables as needed
