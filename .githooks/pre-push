#!/usr/bin/env bash
#
# Checks the OpenSpec <-> implementation-plan link before anything leaves the machine.
#
# Implementation plans cite OpenSpec task ids under "## OpenSpec Coverage" so that a
# finished plan can be traced back to the tasks it was supposed to deliver. Nothing
# generates or validates that section — OpenSpec does not know plans exist, and the plan
# tooling does not know OpenSpec exists — so a citation that points at a task id which
# was renumbered, or at a change that was renamed, is wrong in a way that produces no
# error anywhere. This hook is the only thing that would notice.
#
# It refuses to guess. A push with no plan files passes untouched, and a citation is only
# rejected when the change or the task id demonstrably does not exist.
#
# Enable with: git config core.hooksPath .githooks
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PLAN_GLOB="docs/superpowers/plans"
failures=0

note() { printf '  %s\n' "$1" >&2; }

# Resolve a change slug to its tasks.md, whether it is still active or already archived.
tasks_file_for() {
  local slug="$1" f
  f="$REPO_ROOT/openspec/changes/$slug/tasks.md"
  [ -f "$f" ] && { printf '%s' "$f"; return 0; }
  f=$(find "$REPO_ROOT/openspec/changes/archive" -maxdepth 1 -type d -name "*-$slug" 2>/dev/null | head -1)
  [ -n "$f" ] && [ -f "$f/tasks.md" ] && { printf '%s' "$f/tasks.md"; return 0; }
  return 1
}

check_plan() {
  local plan="$1"
  local rel="${plan#"$REPO_ROOT"/}"

  # The section is optional only for plans that cite nothing; a plan that mentions a
  # change without listing ids cannot be traced and is treated as a miss.
  # The section is the content directly under the heading, ending at the next heading of ANY
  # level or a horizontal rule. Ending only at `## ` let a plan without a rule spill its whole
  # body into the id scan, where its version numbers read as task ids and refused the push.
  #
  # A `### ` subheading therefore ends the section too, which means ids listed beneath one are
  # not seen. That is deliberate and safe now: a section yielding no ids FAILS below rather
  # than passing, so an unsupported layout is refused loudly instead of waved through. Intervals
  # like `#{1,2}` are avoided because mawk 1.3.3 treats them literally.
  local section
  section=$(awk '
    /^```/ { fence = !fence }
    /^## OpenSpec Coverage/ { flag = 1; next }
    flag && !fence && (/^#/ || /^---[[:space:]]*$/) { flag = 0 }
    flag
  ' "$plan")
  [ -z "$section" ] && return 0

  local slug
  slug=$(printf '%s' "$section" | grep -oE 'openspec/changes/[A-Za-z0-9._-]+' | head -1 | sed 's|openspec/changes/||')
  if [ -z "$slug" ]; then
    slug=$(printf '%s' "$section" | grep -oE '^[[:space:]]*[-*][[:space:]]+[A-Za-z0-9._-]+' | head -1 | awk '{print $2}')
  fi

  if [ -z "$slug" ]; then
    note "$rel: OpenSpec Coverage names no change"
    return 1
  fi

  local tasks
  if ! tasks=$(tasks_file_for "$slug"); then
    note "$rel: cites change '$slug', which exists neither in openspec/changes nor in its archive"
    return 1
  fi

  # Ids are recognised by SHAPE AND BOUNDARY, not by which position they sit in. Earlier
  # versions guessed the position — whole section, then list-and-table lines, then the last
  # table cell — and each guess only moved the failure: a Status column broke one, a Notes
  # column broke the next, a spaced comparator broke the one after.
  #
  # An id run must BEGIN at a structural boundary: the start of a table cell, the text after a
  # list marker, or the text after an arrow. A version never does — it trails a name
  # ("pnpm 11.1") or a comparator (">= 22.16"), so it never starts a run. A table cell must
  # additionally consist of nothing but ids, commas, and spaces, which is what a coverage cell
  # looks like and what a descriptive cell never does.
  local ids
  ids=$(printf '%s\n' "$section" | awk '
    function take_run(s) {
      while (match(s, /^[0-9]+\.[0-9]+/)) {
        print substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
        if (s ~ /^[,[:space:]]+/) sub(/^[,[:space:]]+/, "", s); else break
      }
    }
    {
      # A run may also start after an arrow, on any kind of line ("Step 3 -> 99.99").
      rest = $0
      while (match(rest, /(->|=>)[[:space:]]*/)) {
        rest = substr(rest, RSTART + RLENGTH)
        take_run(rest)
      }
    }
    /^[[:space:]]*\|/ {
      n = split($0, cells, "|")
      for (i = 1; i <= n; i++) {
        c = cells[i]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", c)
        if (c ~ /^[0-9]+\.[0-9]+([,[:space:]]+[0-9]+\.[0-9]+)*$/) take_run(c)
      }
      next
    }
    {
      # Outside a table: a run that reaches the end of the line, as in "- Covers 1.1, 1.2, 2.1".
      # The text before it must not end in a comparator, which is what separates that from
      # "... and pnpm > 11.1". Both forms end in digits; only one is a citation.
      line = $0
      sub(/[[:space:]]+$/, "", line)
      if (match(line, /[0-9]+\.[0-9]+([,[:space:]]+[0-9]+\.[0-9]+)*$/)) {
        before = substr(line, 1, RSTART - 1)
        if (before !~ /[<>=^~][[:space:]]*$/) take_run(substr(line, RSTART))
      }
    }
    /^[[:space:]]*[-*+][[:space:]]+/ {
      line = $0
      sub(/^[[:space:]]*[-*+][[:space:]]+/, "", line)
      take_run(line)
    }
  ' | sort -u)

  # A section that names a change but yields no ids cannot be traced, and passing it would be
  # the same "found nothing to look at, so reported ok" failure this hook exists to prevent.
  if [ -z "$ids" ]; then
    note "$rel: OpenSpec Coverage cites no task ids"
    note "  (list them directly under the heading — a '### ' subheading ends the section)"
    return 1
  fi

  local missing=""
  local id
  for id in $ids; do
    grep -qE "^[[:space:]]*-[[:space:]]*\[[ x]\][[:space:]]*$id([[:space:]]|\.)" "$tasks" || missing="$missing $id"
  done

  if [ -n "$missing" ]; then
    note "$rel: cites task ids not present in $slug/tasks.md —$missing"
    note "  (task ids are load-bearing; renumbering them breaks this link silently)"
    return 1
  fi

  return 0
}

while IFS= read -r plan; do
  [ -f "$plan" ] || continue
  check_plan "$plan" || failures=$((failures + 1))
done < <(find "$REPO_ROOT/$PLAN_GLOB" -type f -name '*.md' 2>/dev/null)

if [ "$failures" -gt 0 ]; then
  printf '\npush refused: %d implementation plan(s) cite OpenSpec tasks that do not resolve.\n' "$failures" >&2
  printf 'Fix the citation, or the task ids it points at, then push again.\n' >&2
  exit 1
fi

exit 0
