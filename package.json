{
  "name": "forgekit-workflow",
  "private": true,
  "description": "Development-workflow tooling for this repository. Not part of the API or the app.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.16",
    "pnpm": ">=11"
  },
  "forgekit": {
    "sourceGlobs": [
      "*.cs",
      "*.ts",
      "*.tsx",
      "*.js",
      "*.jsx",
      "*.mjs",
      "*.cjs",
      "*.mts",
      "*.cts"
    ],
    "requiredTools": [
      "dotnet"
    ],
    "nodeSubprojects": [
      "app"
    ]
  },
  "scripts": {
    "preflight": "bash scripts/preflight.sh",
    "sync-workflow": "bash scripts/sync-workflow.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.5.0",
    "@fission-ai/openspec": "^1.9.0",
    "grillme": "latest"
  }
}
